# Secrets for the agent Edge Functions. Copy to supabase/functions/.env (git-ignored) for local
# runs, and set them in production with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on Supabase.

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every call (setWebhook secret_token).
TELEGRAM_WEBHOOK_SECRET=

# --- Main model: ANY OpenAI-compatible endpoint ------------------------------------
# Google AI Studio (free tier — do NOT send real personal data, see docs/ai-agent.md):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Other examples:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama      LLM_BASE_URL=http://your-server:11434             LLM_MODEL=qwen2.5:14b   (native API, see docs/ollama.md)
#   Claude      LLM_BASE_URL=https://api.anthropic.com/v1/        LLM_MODEL=claude-sonnet-5-5
# API dialect: openai | ollama (automatic: ollama for port 11434 and ollama.com). Per role: LLM_VISION_PROVIDER...
# LLM_PROVIDER=
# Extra HTTP headers as JSON, e.g. Cloudflare Access in front of a private Ollama. Per role: LLM_VISION_HEADERS...
# LLM_HEADERS={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
# Ollama only (all roles): context window, how long models stay loaded, thinking on/off (true|false|low|medium|high)
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_THINK=false
# Declare capabilities of a model the agent does not know (tools, json_schema | json_object, vision, audio):
# LLM_CAPS=json_object,vision

# --- Optional roles (each falls back to the main model) ------------------------------
# LLM_VISION_BASE_URL=   LLM_VISION_API_KEY=   LLM_VISION_MODEL=   LLM_VISION_CAPS=
# LLM_FAST_BASE_URL=     LLM_FAST_API_KEY=     LLM_FAST_MODEL=     LLM_FAST_CAPS=
# Used when the main provider answers 404 (model retired) / 429 / 5xx / times out:
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_MS=45000          (default 120000 when the main model is on Ollama)
# Extra attempts on the same model when it is overloaded (503/429) or unreachable, with backoff:
# LLM_RETRIES=2

# --- Speech-to-text (optional; without it, voice works only if the main model hears audio, e.g. Gemini)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=ar

# --- Voice replies (optional) ---------------------------------------------------------
# TTS_BASE_URL=
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE=
# TTS_FORMAT=opus

# --- PDF (optional; without it the bot sends a printable .html file) --------------------
# Gotenberg: docker run --rm -p 3000:3000 gotenberg/gotenberg:8
# PDF_SERVICE_URL=https://your-gotenberg.example.com
# PDF_SERVICE_BASIC_AUTH=user:password

# --- Admin dashboard telemetry (migration 003) ----------------------------------------
# On by default once migration 003 is applied; set to off to record nothing.
# AGENT_METRICS=off
