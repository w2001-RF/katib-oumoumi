# Copy to .env (git-ignored) and fill in: the same project as the web app
# (supabase-config.js). The anon key is public by design; never put the
# service_role key here, EXPO_PUBLIC_ values ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
